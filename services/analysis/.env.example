# Generate a random 32-char secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match ANALYSIS_SERVICE_SECRET in apps/web/.env.local
ANALYSIS_SERVICE_SECRET=

PORT=8000

# ── CLAP ─────────────────────────────────────────────────────────────────────
# Path to the LAION-CLAP checkpoint. The Dockerfile bakes this into the image,
# so it only needs setting for local dev or to pin a different checkpoint.
# Download: https://huggingface.co/lukewys/laion_clap (music_audioset_* ~2.35GB)
#
# Changing the checkpoint changes the embedding space. Bump EMBEDDING_MODEL_ID
# in main.py at the same time and re-seed the catalog — vectors from two
# different checkpoints are not comparable, and mixing them fails silently.
CLAP_CHECKPOINT_PATH=/models/music_audioset_epoch_15_esc_90.14.pt
CLAP_AUDIO_MODEL=HTSAT-base

# ── Concurrency ──────────────────────────────────────────────────────────────
# Analyses allowed to run at once. Run ONE uvicorn worker (the checkpoint is
# ~2GB resident per process) and scale here instead. Analysis is CPU-bound, so
# going much past the core count just adds contention.
ANALYSIS_CONCURRENCY=2

# Max audio accepted, in bytes. Full-length uploads are far larger than a 30s
# preview; this bounds memory per request. Default 60MB.
MAX_AUDIO_BYTES=62914560
AUDIO_FETCH_TIMEOUT_S=60
