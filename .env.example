# Copy this file to apps/web/.env.local and fill in all values.
# See CLAUDE.md → Manual Setup Checklist for step-by-step instructions.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Spotify (metadata only — no audio analysis scopes needed) ───────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Analysis Service (Railway) ───────────────────────────────────────────────
ANALYSIS_SERVICE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYSIS_SERVICE_SECRET=

# ── Matching (web app, optional) ─────────────────────────────────────────────
# Minimum cosine similarity for a window to be shown as a match. PROVISIONAL —
# retune against the real score distribution once the catalog is seeded:
#   SELECT percentile_cont(ARRAY[0.5,0.9,0.99]) WITHIN GROUP (ORDER BY sim) ...
# Too low and the tail of unrelated tracks is presented as matches; too high and
# real matches are suppressed. Defaults to 0.35.
MATCH_MIN_SIMILARITY=0.35

# ── Apple Music API ──────────────────────────────────────────────────────────
# Required for genre enrichment, ISRC-based track resolution, Apple Music deep
# links on result cards, preview URL fallback, and charts-driven pre-analysis.
# Setup: Apple Developer Program → Certificates, Identifiers & Profiles →
#   Identifiers → Media IDs → enable MusicKit + Apple Music Feed → create Key.
#
# APPLE_MUSIC_KEY_ID     — 10-char Key ID shown after creating the key
# APPLE_MUSIC_TEAM_ID    — 10-char Team ID from your Apple Developer account
# APPLE_MUSIC_PRIVATE_KEY — P-256 PEM contents with literal \n for newlines:
#   e.g. "-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----"
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_PRIVATE_KEY=

# ── Inngest ──────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
