# Copy this file to apps/web/.env.local and fill in all values.
# See CLAUDE.md → Manual Setup Checklist for step-by-step instructions.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Spotify (metadata only — no audio analysis scopes needed) ───────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Analysis Service (Railway) ───────────────────────────────────────────────
ANALYSIS_SERVICE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYSIS_SERVICE_SECRET=

# ── Inngest ──────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
